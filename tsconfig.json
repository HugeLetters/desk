{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"allowImportingTsExtensions": true,
		"noImplicitOverride": true,
		"plugins": [
			{
				"name": "@effect/language-service",
				"namespaceImportPackages": ["effect", "@effect/*"],
				"importAliases": {
					"Array": "Array_",
					"String": "String_",
					"Number": "Number_",
					"Boolean": "Boolean_",
					"BigInt": "BigInt_",
					"Function": "Function_",
					"Record": "Record_",
					"Symbol": "Symbol_",
					"Date": "Date_",
					"RegExp": "RegExp_"
				},
				"topLevelNamedReexports": "follow"
			}
		]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "page/**/*.ts", "page/**/*.tsx", "tests/**/*.ts", "demo/**/*.ts"]
}
