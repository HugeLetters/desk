{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"allowImportingTsExtensions": true,
		"noImplicitOverride": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "page/**/*.ts", "page/**/*.tsx", "tests/**/*.ts", "demo/**/*.ts"]
}
