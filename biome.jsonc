{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/page/dist"]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "error",
				"noDescendingSpecificity": "off",
				"useConsistentArrayType": {
					"level": "error",
					"fix": "safe",
					"options": {
						"syntax": "generic"
					}
				}
			}
		},
		"domains": {
			"solid": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["src/tui/**"],
			"linter": {
				"rules": {
					"a11y": "off"
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		},
		"linter": {
			"enabled": false
		}
	}
}
